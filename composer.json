{
  "name": "enquadramento/site",
  "description": "PHP news aggregation and editorial site",
  "type": "project",
  "scripts": {
    "serve": "php -S localhost:8000 -t public",
    "autoload": "composer dump-autoload",
    "test": "vendor/bin/phpunit -c phpunit.xml.dist",
    "stan": "vendor/bin/phpstan analyse -c phpstan.neon.dist --no-progress --debug --memory-limit=512M"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1"
  }
}
